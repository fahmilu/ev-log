# Neon Postgres connection string (injected automatically by the Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password to log in to the app
NUXT_APP_PASSWORD=change-me

# Session cookie encryption key, min 32 characters (generate: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=replace-with-a-random-string-of-at-least-32-chars
